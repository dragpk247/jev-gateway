#!/usr/bin/env bash
# Jev Gateway Global CLI Driver
set -e

GATEWAY_DIR="$HOME/Projects/jev-gateway"
PYTHON_BIN="$(command -v python3)"
PID_FILE="$HOME/.local/share/obsidian-ai-router/jev-gateway.pid"

PORT="${PORT:-8085}"

case "$1" in
  start)
    systemctl --user start jev-gateway.service 2>/dev/null || {
      PORT="$PORT" nohup "$PYTHON_BIN" "$GATEWAY_DIR/server.py" > "$HOME/.local/share/obsidian-ai-router/server.log" 2>&1 &
      echo $! > "$PID_FILE"
    }
    sleep 1
    echo "✓ Running. Web Dashboard: http://localhost:$PORT/dashboard"
    ;;

  stop)
    systemctl --user stop jev-gateway.service 2>/dev/null || true
    pkill -f "python3.*jev-gateway/server.py" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "✓ Stopped."
    ;;

  status)
    if systemctl --user is-active --quiet jev-gateway.service 2>/dev/null || curl -s "http://localhost:$PORT/health" >/dev/null 2>&1; then
      echo "● Jev Gateway is ACTIVE on http://localhost:$PORT"
      curl -s "http://localhost:$PORT/health" || echo ""
    else
      echo "○ Jev Gateway is INACTIVE."
    fi
    ;;

  dashboard)
    xdg-open "http://localhost:$PORT/dashboard" 2>/dev/null || echo "Open in your browser: http://localhost:$PORT/dashboard"
    ;;

  stats)
    curl -s http://localhost:$PORT/api/stats | python3 -m json.tool
    ;;

  "")
    echo "Usage: jev [command | 'your prompt']"
    echo ""
    echo "Commands:"
    echo "  jev start            Start background HTTP proxy daemon"
    echo "  jev stop             Stop background HTTP proxy daemon"
    echo "  jev status           Check server status and health"
    echo "  jev dashboard        Open Web Telemetry Dashboard in browser"
    echo "  jev stats            Inspect token & dollar savings via CLI"
    echo "  jev --exec <prompt>  Route and execute prompt directly via CLI"
    echo "  jev <prompt>         Dry-run route inspection"
    ;;

  *)
    # Default: Pass through to main CLI
    "$PYTHON_BIN" "$GATEWAY_DIR/main.py" "$@"
    ;;
esac
